# Copy to .env or run python configure.py. Never commit your real key.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Your Google project must have access to these models.
# Override the model IDs if required by your account.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
GEMINI_VOICE=Aoede

# Independent local notes. Optional: set an absolute path inside your own Obsidian vault.
OBSIDIAN_NOTES_DIR=notes
WEB_HOST=127.0.0.1
WEB_PORT=8000

